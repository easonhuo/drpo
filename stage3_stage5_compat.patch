+def first_parent_repository_commit_for_path(repo_root: Path, path: Path) -> str:
+    """Return the first-parent commit that integrated an authoritative path.
+
+    Stage 5 permits a schema-v3 delta or materialization report to be authored
+    and revised on a side branch before one GitHub merge integration. Stage 3
+    only needs the resulting integration commit for observation timing; Stage 5
+    remains the authority for full path-history validation.
+    """
+
+    relative = path.resolve().relative_to(repo_root.resolve()).as_posix()
+    result = git(
+        repo_root,
+        "log",
+        "--first-parent",
+        "--diff-merges=first-parent",
+        "--diff-filter=A",
+        "--format=%H",
+        "--",
+        relative,
+        check=False,
+    )
+    commits = [line.strip() for line in result.stdout.splitlines() if line.strip()]
+    if len(commits) != 1:
+        raise HandoffDeltaError(
+            "authoritative path must have exactly one first-parent integration: "
+            + relative
+        )
+    return commits[0]
+
+
+def verify_authoritative_path_unchanged_after_integration(
+    repo_root: Path, path: Path, integration_commit: str
+) -> None:
+    """Reject any first-parent mutation after the Stage 5 integration commit."""
+
+    relative = path.resolve().relative_to(repo_root.resolve()).as_posix()
+    head = git_text(repo_root, "rev-parse", "HEAD")
+    later_touches = git_text(
+        repo_root,
+        "rev-list",
+        "--first-parent",
+        "--reverse",
+        f"{integration_commit}..{head}",
+        "--",
+        relative,
+    ).splitlines()
+    if later_touches:
+        raise HandoffDeltaError(
+            "authoritative delta/report changed after first-parent integration"
+        )
+    if git_show_text(repo_root, integration_commit, relative) != path.read_text(
+        encoding="utf-8"
+    ):
+        raise HandoffDeltaError(
+            "authoritative delta/report bytes differ from integration commit"
+        )
+
+
